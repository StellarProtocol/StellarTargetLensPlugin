<Project>
  <PropertyGroup>
    <!-- Path to your local game_mini folder. Copy this file to Local.props and fill in your path. -->
    <!-- Used by the DeployPlugin target to copy the built DLL to the game's plugin directory. -->
    <GameInstallDir>C:\path\to\game_mini</GameInstallDir>
    <PluginDeployDir>$(MSBuildThisFileDirectory)plugins\targetlens\</PluginDeployDir>
    <GamePluginDir>$(GameInstallDir)\stellar\plugins\targetlens\</GamePluginDir>
  </PropertyGroup>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginDeployDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GamePluginDir)" />
  </Target>
</Project>
