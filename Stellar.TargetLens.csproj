<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Stellar.TargetLens</RootNamespace>
    <AssemblyName>Stellar.TargetLens</AssemblyName>
    <Version>1.3.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Framework 2.2.0 ships the BarElement overlay props (Overlay01 / OverlayColor / OverlayInFront) on the
       published NuGet, so the earlier local-source override is gone — compile straight against the packages.
       Stellar.Plugin.InteropRefs has no 2.2.0 (build-assets package, versions independently; unchanged since 2.0.0). -->
  <!-- 2.34.0: SlicedImageElement, StackLayer.Rect, ImageElement.Crisp and the Modern-bar gradient/trail/stripes/ticks
       opt-ins used by the boss-bar Target HUD. -->
  <!-- Bumped to 2.3.0 for the i18n-ko launcher-tile review fix: LauncherEntry.TitleProvider (live-localized
       tile title, needed so Title can stay the fixed pin-identity literal) was added in Abstractions 2.3.0 —
       additive/binary-compatible per framework/CHANGELOG.md [2.3.0]. -->
  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions"       Version="2.34.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.34.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.34.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/targetlens-icon.png" LogicalName="Stellar.TargetLens.targetlens-icon.png" />
    <!-- English-translated buff name/description dump (game data is Chinese). Loaded by TranslatedBuffText.
         Kept inside the project's Resources/ (colocated with the icon) so it can't be lost as a loose Mod-root file. -->
    <EmbeddedResource Include="Resources\BuffTable.json" LogicalName="Stellar.TargetLens.BuffTable.json" />
    <!-- Nearby Monsters hard-lock padlock: white glyphs pre-drawn per size (tools/gen_lock_icons.py), tinted gold at draw. -->
    <EmbeddedResource Include="Resources/lock-*.png" LogicalName="Stellar.TargetLens.%(Filename)%(Extension)" />
    <!-- Settings header crosshair glyph: white, pre-drawn per size (tools/gen_header_icon.py), on the live accent tile. -->
    <EmbeddedResource Include="Resources/header-*.png" LogicalName="Stellar.TargetLens.%(Filename)%(Extension)" />
    <!-- Target Effects (effect picker) header star glyph: white, pre-drawn per size (tools/gen_star_icon.py). -->
    <EmbeddedResource Include="Resources/star-*.png" LogicalName="Stellar.TargetLens.%(Filename)%(Extension)" />
    <!-- Target HUD "Celestial Crest" v3 boss-bar art (user-approved 2026-11-18): 3-slice frame + rank badges at 2× (Large),
         @1.5x (Medium) and @1x (Slim); portrait-disc-<px>: the blue backing disc under the portrait (tools/gen_portrait_disc.py, Pillow, 8x supersampled). -->
    <EmbeddedResource Include="Resources/celestial_crest_*.png" LogicalName="Stellar.TargetLens.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources/portrait-disc-*.png" LogicalName="Stellar.TargetLens.%(Filename)%(Extension)" />
    <!-- Crest overlay glyphs (diamond, hairline, rank medallions, BOSS/ELITE pills), pre-drawn per row size by tools/gen_crest_icons.py. -->
    <EmbeddedResource Include="Resources/crest-*.png" LogicalName="Stellar.TargetLens.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

  <!-- i18n: consumes IPluginServices.Localization. The framework AUTO-loads each catalog by the
       Stellar.TargetLens.Lang.<locale>.json logical-name convention — there is NO explicit register call. -->
  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json"  LogicalName="Stellar.TargetLens.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json"  LogicalName="Stellar.TargetLens.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json"  LogicalName="Stellar.TargetLens.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json"  LogicalName="Stellar.TargetLens.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.TargetLens.Lang.fil.json" />
    <EmbeddedResource Include="Lang/ko.json"  LogicalName="Stellar.TargetLens.Lang.ko.json" />
  </ItemGroup>

</Project>
